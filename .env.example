# Copy to .env only when you choose to configure external AI.
# Never put a real key in the browser, a project file, or chat.
OPENROUTER_API_KEY=
OPENCODE_API_KEY=
ANGLEFORGE_AI_PROVIDER=openrouter
# Choose a current exact model ID from the editor's public catalog.
# For Zen Muse Spark: ANGLEFORGE_AI_PROVIDER=zen; ANGLEFORGE_AI_MODEL=muse-spark-1.3
ANGLEFORGE_AI_MODEL=
ANGLEFORGE_AI_MAX_TOKENS=1600
ANGLEFORGE_AI_TOTAL_OUTPUT_TOKENS=4800
ANGLEFORGE_AI_RETRIES=1
ANGLEFORGE_AI_TIMEOUT_SECONDS=45
# Optional absolute paths when native binaries are not on PATH:
# ANGLEFORGE_FFMPEG=/path/to/ffmpeg
# ANGLEFORGE_FFPROBE=/path/to/ffprobe
# ANGLEFORGE_DATA_DIR=/path/to/local/angleforge-data
